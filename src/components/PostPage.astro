---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import { SITE } from "../config";
import { formatDate, postPath, type Locale } from "../i18n";
import type { Post } from "../posts";

export interface Props {
  post: Post;
  /** The same post in the other language, if it exists. */
  translation?: Post;
}

const { post, translation } = Astro.props;
const { locale, slug, data } = post;
const { Content } = await render(post);
const author = SITE.author[locale];

const alternates: Partial<Record<Locale, string>> = {
  [locale]: postPath(locale, slug),
};
if (translation) alternates[translation.locale] = postPath(translation.locale, slug);
---

<Base
  locale={locale}
  title={data.title}
  description={data.description}
  image={data.image}
  alternates={alternates}
  article={{ published: data.date, modified: data.updated, tags: data.tags }}
  switchTo={translation && {
    locale: translation.locale,
    href: postPath(translation.locale, slug),
  }}
>
  <main class="site-main article-page">
    <div class="article-container">
      <article class="article-content prose">
        <h1>{data.title}</h1>
        <Content />
      </article>
      <aside class="article-meta">
        <div class="author-card">
          <img src={SITE.author.image} alt={author.name} width="96" height="96" />
          <h3>{author.name}</h3>
          <div class="author-role">{author.role}</div>
          <time datetime={data.date.toISOString()}>{formatDate(data.date, locale)}</time>
        </div>
      </aside>
    </div>
  </main>
</Base>
