---
import { LOCALE_META, STRINGS, formatYear, localePath, type Locale } from "../i18n";
import { SITE } from "../config";

export interface Props {
  locale: Locale;
  /** Add a "back to all notes" link (article pages). */
  back?: boolean;
  /** The same page in the other language, when it exists. */
  switchTo?: { locale: Locale; href: string };
}

const { locale, back = false, switchTo } = Astro.props;
const t = STRINGS[locale];
const year = formatYear(new Date(), locale);
---

<footer class="foot">
  <div class="wrap foot-in">
    <p>
      © {year} <span dir="ltr">{SITE.name}</span>. {t.rights}
    </p>
    <p class="foot-links">
      {back && <a href={`${localePath(locale)}#notes`}>{t.backToTop} <span aria-hidden="true">↑</span></a>}
      {
        switchTo && (
          <a
            class="foot-lang"
            href={switchTo.href}
            hreflang={switchTo.locale}
            lang={switchTo.locale}
            dir={switchTo.locale === "en" ? "ltr" : "rtl"}
          >
            {LOCALE_META[switchTo.locale].label}
          </a>
        )
      }
    </p>
  </div>
</footer>
