---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import Wordmark from "../components/Wordmark.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../config";
import NoteRows from "../components/NoteRows.astro";
import LiveSphere from "../components/LiveSphere.astro";
import { GIRIH_LINES } from "../girih";
import { ART_CREDIT, FEATURED_PIECE, MADE_WITH, artPath } from "../art";
import {
  STRINGS,
  formatNumber,
  localePath,
  notePath,
  siteDescription,
  type Locale,
} from "../i18n";
import { getNotes } from "../posts";

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const other: Locale = locale === "en" ? "fa" : "en";
const t = STRINGS[locale];
const notes = await getNotes(locale);
const [featured, ...rest] = notes;
const categories = [...new Set(notes.map((n) => n.category))];
---

<Base
  locale={locale}
  title={SITE.name}
  description={siteDescription(locale)}
  alternates={{ en: localePath("en"), fa: localePath("fa") }}
>
  <section class="hero dark">
    <div class="blob b1" aria-hidden="true"></div>
    <div class="blob b2" aria-hidden="true"></div>
    <div class="hero-girih-layer" aria-hidden="true">
      <canvas class="hero-girih" data-girih></canvas>
      <script type="application/json" id="girih-lines" set:html={JSON.stringify(GIRIH_LINES)} />
    </div>
    <div class="wrap hero-in">
      <SiteNav locale={locale} variant="home" switchTo={{ locale: other, href: localePath(other) }} />
      <main class="hero-main">
        <Wordmark big heading />
        <p class="tagline rise-in" style="--d:900ms">{t.tagline}</p>
        <p class="descriptor rise-in" style="--d:1000ms">{t.descriptor}</p>
      </main>
    </div>
  </section>

  {
    categories.length > 0 && (
      <div class="topic-strip">
        <p class="wrap topic-line">
          <span class="topic-label">{t.topics}</span>
          {categories.map((c, i) => (
            <>
              {i > 0 && <span class="sep" aria-hidden="true">·</span>}
              <span>{c}</span>
            </>
          ))}
        </p>
      </div>
    )
  }

  <section class="sect" id="notes" aria-labelledby="notes-title">
    <div class="wrap">
      <div class="sect-head rv">
        <h2 id="notes-title">{t.latestNotes}</h2>
        {
          categories.length > 1 && (
            <div class="chips" role="group" aria-label={t.latestNotes}>
              <button type="button" class="chip active" data-filter="*" aria-pressed="true">{t.filterAll}</button>
              {categories.map((c) => (
                <button type="button" class="chip" data-filter={c} aria-pressed="false">{c}</button>
              ))}
            </div>
          )
        }
      </div>

      {
        !featured ? (
          <p class="empty rv">{t.noNotes}</p>
        ) : (
          <>
            <a class="feat rv" href={notePath(locale, featured.slug)} data-category={featured.category}>
              <span class="feat-glow" aria-hidden="true"></span>
              <span class="feat-meta">
                <span class="badge">{t.newBadge}</span>
                <span class="meta-text">{featured.category}</span>
                <span class="meta-text">{formatNumber(featured.readingMinutes, locale)} {t.minRead}</span>
              </span>
              <span class="feat-title">{featured.data.title}</span>
              <span class="feat-sum">{featured.data.description}</span>
            </a>

            {rest.length > 0 && <NoteRows locale={locale} notes={rest} start={2} />}
          </>
        )
      }

      <p class="follow rv">
        <a class="follow-link" href={localePath(locale, "/rss.xml")}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M5 4a15 15 0 0 1 15 15M5 11a8 8 0 0 1 8 8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><circle cx="6" cy="18" r="2" fill="currentColor"/></svg>
          {t.followRss}
        </a>
        <span class="follow-hint">{t.followHint}</span>
      </p>
    </div>
  </section>

  <section class="art-band" id="art" aria-labelledby="art-title">
    <div class="wrap art-band-in">
      <div class="art-band-text rv">
        <p class="eyebrow">{t.artTitle}</p>
        <h2 id="art-title">{t.artBandTitle}</h2>
        <p class="art-band-body">{t.artBandBody}</p>
        <a class="art-more" href={artPath(locale)}>{t.artAll} <span aria-hidden="true">{locale === "fa" ? "←" : "→"}</span></a>
        <p class="art-credit">{MADE_WITH[locale]} · {ART_CREDIT[locale]}</p>
      </div>
      <div class="art-band-visual rv">
        <LiveSphere locale={locale} piece={FEATURED_PIECE} />
      </div>
    </div>
  </section>

  <Footer locale={locale} switchTo={{ locale: other, href: localePath(other) }} />

  <script>
    import { drawGirih } from "../scripts/girih-canvas.js";

    // The girih behind the wordmark draws itself once; reduced motion gets the finished pattern.
    const girih = document.querySelector<HTMLCanvasElement>("[data-girih]");
    const girihData = document.getElementById("girih-lines");
    if (girih && girihData) {
      const lines: number[] = JSON.parse(girihData.textContent || "[]");
      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
      drawGirih(girih, lines, { animate: !still });
    }
  </script>

  <script>
    // Category chips filter the featured note and the rows client-side.
    const chips = document.querySelectorAll<HTMLButtonElement>(".chip[data-filter]");
    const items = document.querySelectorAll<HTMLElement>("[data-category]");
    chips.forEach((chip) =>
      chip.addEventListener("click", () => {
        const f = chip.dataset.filter!;
        chips.forEach((c) => {
          const on = c === chip;
          c.classList.toggle("active", on);
          c.setAttribute("aria-pressed", String(on));
        });
        items.forEach((el) => {
          el.hidden = f !== "*" && el.dataset.category !== f;
        });
      }),
    );
  </script>
</Base>
