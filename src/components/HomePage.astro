---
import Base from "../layouts/Base.astro";
import { SITE } from "../config";
import { STRINGS, formatDate, localePath, postPath, type Locale } from "../i18n";
import { getPosts } from "../posts";

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const other: Locale = locale === "en" ? "fa" : "en";
const t = STRINGS[locale];
const posts = await getPosts(locale);
---

<Base
  locale={locale}
  title={SITE.name}
  description={t.description}
  alternates={{ en: localePath("en"), fa: localePath("fa") }}
  switchTo={{ locale: other, href: localePath(other) }}
>
  <main class="site-main home">
    <div class="center-content">
      <img src="/images/logo.png" alt="hassanBake logo" class="main-logo" width="339" height="290" />
      <section class="hero">
        {
          locale === "en" ? (
            <h1 class="hero-title">
              from raw ideas to <b class="brand-b">B</b>aked understanding
            </h1>
          ) : (
            <h1 class="hero-title">{t.tagline}</h1>
          )
        }
        <p class="hero-subtitle">{t.description}</p>
      </section>
    </div>

    <section class="post-list" aria-labelledby="posts-heading">
      <h2 id="posts-heading">{t.posts}</h2>
      {
        posts.length === 0 ? (
          <p class="empty">{t.noPosts}</p>
        ) : (
          <ul>
            {posts.map((post) => (
              <li>
                <a href={postPath(locale, post.slug)}>{post.data.title}</a>
                <time datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date, locale)}
                </time>
                <p>{post.data.description}</p>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </main>
</Base>
