---
import { STRINGS, formatDate, formatNumber, notePath, type Locale } from "../i18n";
import type { Note } from "../posts";

export interface Props {
  locale: Locale;
  notes: Note[];
  /** Number shown on the first row. */
  start?: number;
}

const { locale, notes, start = 1 } = Astro.props;
const t = STRINGS[locale];
const rowNumber = (i: number) =>
  locale === "fa" ? formatNumber(i + start, locale) : String(i + start).padStart(2, "0");
---

<ul class="rows">
  {
    notes.map((note, i) => (
      <li class="rv" data-category={note.category}>
        <a class="row" href={notePath(locale, note.slug)}>
          <span class="row-num" aria-hidden="true">{rowNumber(i)}</span>
          <span class="row-main">
            <span class="row-title">{note.data.title}</span>
            <span class="row-teaser">{note.teaser}</span>
          </span>
          <span class="chip-static">{note.category}</span>
          <span class="row-meta">
            <time class="row-date" datetime={note.data.date.toISOString()}>{formatDate(note.data.date, locale)}</time>
            <span class="row-read">{formatNumber(note.readingMinutes, locale)} {t.minRead}</span>
          </span>
          <span class="row-arrow" aria-hidden="true">{locale === "fa" ? "←" : "→"}</span>
        </a>
      </li>
    ))
  }
</ul>
